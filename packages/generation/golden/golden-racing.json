  "story": {
    "intro": [
      "The Ember Cup posts three races across the hover leagues.",
      "You, rookie pilot Pippa Vane, borrowed a cyan hull and a full boost cell.",
      "Beat VEX, JUNO, PIP and KAZ, and take the finale from VEX PRIME."
    ],
    "levelIntros": [
      "Ember Loop: hairpin and S-curves through the ember fields.",
      "Coral Sweep: fast double-apex sweepers along the coral coast.",
      "Ratchet Chicane: tight stadium chicanes. VEX PRIME defends the finale."
    ],
    "bossIntro": "VEX PRIME holds the inside line and the points lead. Take the finale.",
    "victory": [
      "Checkered flag. The cup is yours, Pippa Vane.",
      "The pits chant your line through every sweeper home."
    ],
    "defeat": [
      "VEX PRIME keeps the cup. The hull is intact and the cell recharges.",
      "Run the lines again. The trophy stays on the table."
    ]
  },

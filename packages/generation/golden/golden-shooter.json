 "meta": {
  "title": "Signal Ascendant",
  "tagline": "Pilot the signal and align intelligence for everyone",
  "heroConcept": "You wear a charcoal technical flight suit with signal-white piping, graphite bomber collar, matte mission patches, slim light-grey gloves and boots, and a harness holding a glowing alignment core at your chest."
 },
 "playerCraft": {
  "visualConcept": "Arrowhead signal craft with pearlescent white hull, teal light seams, clear forward canopy, twin swept ion fins, amber beacon nose and trailing lattice wake"
 },

 "story": {
  "bossIntro": "Titan Compiler steps in, mask glowing: You shipped fast. Now prove you can finish!",
  "defeat": [
   "You tap the mat, grin, and reset. The Connectagon keeps humming.",
   "Patch, Stack, and Mirage cheer you on. Titan nods: Again. Sharper this time."
  ],
  "intro": [
   "You step into the Connectagon, Mark, as the eight walls light up cyan.",
   "Three specialists wait inside: Patch, Stack, Mirage. Beyond them the masked Titan Compiler.",
   "Playful, competitive, competence-forward. Ship fast. Block faster. Take the final round."
  ],
  "levelIntros": [
   "Patch bounces on the cyan rim. Angles, jabs, and quick exits. Stay patient, cut the cage.",
   "Stack plants and presses. Heavy hands and steady pressure. Block, slip, return fire.",
   "Mirage flickers and fades with feints. Read the pattern, trust your timing, take your shot."
  ],
  "victory": [
   "The arena roars as Titan Compiler lowers his mask. Well built, Mark.",
   "Patch, Stack, and Mirage bump gloves. Ship fast, block faster - you took the round.",
   "The Connectagon dims to standby, ready for the next build."
  ]
 },

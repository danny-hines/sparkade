 "meta": {
  "title": "Photon Run",
  "tagline": "Fly the light path and ship the keynote on time.",
  "heroConcept": "You wear a precision lab flight suit from the neck down: matte charcoal techwear jumpsuit with photon-blue piping, micro-mesh panels, magnetic tool harness, slim utility belt, and low-profile mag-boots. Chest badge glows"
 },
 "playerCraft": {
  "visualConcept": "Right-facing diagnostic skiff: needle-thin brushed titanium hull, clear photon-canopy cockpit, twin waveguide runners, cyan light-tail, amber sensor ring motif"
 },

# Provision Neon through the Vercel Marketplace and pull the generated value.
DATABASE_URL=

# Provision Clerk through the Vercel Marketplace. Only allowlisted accounts can
# access /admin even when public Clerk sign-up is enabled.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/me
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/sign-up/complete
SPARKADE_ADMIN_EMAILS=

# Temporary migration fallback for cabinets configured before device pairing.
# New kiosks receive individual credentials through Settings → Registration.
SPARKADE_KIOSK_API_KEY=

# Server-only secret used to encrypt credit-invite codes at rest (AES-256-GCM).
# Required to create/read invites and retain invited signup state; the app
# fails cleanly with an explanatory error when it is missing. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating it makes previously stored codes unreadable (rotation TBD).
SPARKADE_INVITE_CODE_SECRET=
# Optional explicit credit environment. Otherwise VERCEL_ENV, then NODE_ENV,
# is used. Keep preview/test and production credit data separate.
# SPARKADE_CREDIT_ENV=preview
# Genuine-PostgreSQL invite harness (apps/site/test/invites-postgres.test.ts).
# Requires BOTH: an explicit loopback-only scratch database URL and the
# write opt-in. The harness creates one randomly named schema per run,
# confines every connection to it via search_path, and drops only that
# schema afterwards. Never point at production or the app database.
# SPARKADE_PGTEST_URL=postgresql://postgres@127.0.0.1:55439/sparkade_invite_test
# SPARKADE_PGTEST_ALLOW_WRITE=1

# Durable cloud generation (server-only).
SPARKADE_GENERATION_BACKEND=vercel
SPARKADE_GENERATION_SECRET=
META_API_KEY=
# Separate PRIVATE Blob store. BLOB_READ_WRITE_TOKEN above stays PUBLIC.
GENERATION_BLOB_READ_WRITE_TOKEN=
# Shared provider request limits across all functions and devices.
SPARKADE_CLOUD_CONCURRENCY=1024
SPARKADE_CLOUD_OWNER_CONCURRENCY=128
# Vercel sends this secret to the scheduled maintenance endpoint.
CRON_SECRET=

# Website beta settings are managed at /admin/creation per credit environment.
# Creation starts DISABLED with zero USD caps. Set game/daily/total provider
# caps and the credit price before enabling. Input/output review is manual.
# Optional local, no-provider-spend testing (never a production fallback):
# SPARKADE_PROVIDER=mock
# SPARKADE_LOCAL_GENERATION_STORAGE_DIR=/absolute/path/to/sparkade-mock-storage
# WORKFLOW_LOCAL_BASE_URL=http://localhost:3000
# WORKFLOW_LOCAL_DATA_DIR=/absolute/path/to/sparkade-mock-workflows
# Optional isolated Next build directory for a second local test server:
# SPARKADE_SITE_DIST_DIR=.next-verification

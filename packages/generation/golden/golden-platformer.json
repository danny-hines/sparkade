 "story": {
  "bossIntro": "The Overrun awakens - a hydra of Delay, Waste and Heat shrieking as one. Sequence it down, Susan!",
  "defeat": [
   "The campus dims and clocks slip. Dawn is coming, Susan - resequence and try again."
  ],
  "intro": [
   "Sunrise is hours away and the AI compute campus sits dark. You are Susan, and only wise sequencing can bring it online.",
   "Collect compute credits, approve project gates, and turn bold investment into working infrastructure - never hoarding, always building."
  ],
  "levelIntros": [
   "Forecast Floor: Walls of projections and ticking approvals. Approve the gates, Susan, and fund the path forward.",
   "Power Yard: Hum of transformers and shifting yards. Route power true and keep the thermal alarms quiet.",
   "Accelerator Hall: Rows of sleeping accelerators await ignition. Leap the clean-room and wake the core."
  ],
  "victory": [
   "The campus thrums awake, Susan - lights, power, accelerators online before sunrise!",
   "Wise sequencing turned ambition into infrastructure. Capital Quest complete."
  ]
 },

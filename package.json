{
  "name": "sparkade",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted arcade cabinet that generates its own SNES-era games from a photo and a voice prompt.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/danny-hines/sparkade.git"
  },
  "homepage": "https://github.com/danny-hines/sparkade#readme",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "demo": "node scripts/demo.mjs",
    "portal:doctor": "node scripts/portal.mjs doctor",
    "portal:build": "node scripts/portal.mjs build",
    "portal:install": "node scripts/portal.mjs install",
    "portal:provision": "node scripts/portal.mjs provision",
    "portal:promote": "node scripts/portal-promote.mjs",
    "portal:release": "node scripts/portal-release.mjs",
    "portal:test-installer": "node --test scripts/test/portal-installer.test.mjs",
    "portal:boot": "node scripts/portal.mjs boot",
    "portal:boot-off": "node scripts/portal.mjs boot-off",
    "portal:demo": "node scripts/portal-demo.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "site:dev": "npm run dev -w @sparkade/site",
    "site:build": "npm run build -w @sparkade/site",
    "site:typecheck": "npm run typecheck -w @sparkade/site",
    "analyze:repairs": "tsx scripts/analyze-repairs.mts",
    "incidents": "tsx scripts/incidents.mts",
    "tilesets:generate": "tsx scripts/generate-platformer-tileset.mts",
    "tilesets:promote": "tsx scripts/promote-platformer-tileset.mts",
    "adventure-fixtures:promote": "tsx scripts/promote-adventure-fixtures.mts",
    "check:racing": "tsx scripts/check-racing.mts",
    "verify": "node scripts/verify.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^24.0.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.5",
    "vitest": "^3.0.5"
  }
}

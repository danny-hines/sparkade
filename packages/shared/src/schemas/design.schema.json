{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sparkade://schemas/design",
  "title": "Sparkade design pass output",
  "type": "object",
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[ -~]+$" },
    "tagline": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[ -~]+$" },
    "archetype": { "enum": ["platformer", "shooter", "adventure", "hshooter", "fighter"] },
    "palette": {
      "description": "Exactly 16 hex colors. Index 0 is treated as transparent. Slot conventions: 1 outline/darkest, 2-4 background dark->light, 5-7 hero, 8-a enemies, b hazard, c warm accent, d gold, e light, f near-white.",
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
    },
    "heroConcept": {
      "description": "Canonical visual brief for the player hero. When a likeness photo exists, describe the story-specific outfit from the neck down (garments, colors, materials, footwear, and body-worn costume details) without inventing or changing the person's face, hair, eyewear, or headwear.",
      "type": "string",
      "minLength": 1,
      "maxLength": 220,
      "pattern": "^[ -~]+$"
    },
    "combatKit": {
      "description": "Adventure only. Story-specific equipment identities layered over bounded engine combat behavior.",
      "type": "object",
      "properties": {
        "primary": {
          "type": "object",
          "properties": {
            "profile": {
              "description": "close = fists/knife; sweep = sword/bat/wrench; reach = spear/whip.",
              "enum": ["close", "sweep", "reach"]
            },
            "name": { "type": "string", "minLength": 1, "maxLength": 24, "pattern": "^[ -~]+$" },
            "visualConcept": {
              "type": "string",
              "minLength": 8,
              "maxLength": 160,
              "pattern": "^[ -~]+$"
            },
            "unarmed": { "type": "boolean" }
          },
          "required": ["profile", "name", "visualConcept", "unarmed"],
          "additionalProperties": false
        },
        "secondary": {
          "type": "object",
          "properties": {
            "behavior": {
              "description": "shot = bow/gun/blaster; returning = boomerang/disc; blast = bomb/dynamite/mine.",
              "enum": ["shot", "returning", "blast"]
            },
            "name": { "type": "string", "minLength": 1, "maxLength": 24, "pattern": "^[ -~]+$" },
            "visualConcept": {
              "type": "string",
              "minLength": 8,
              "maxLength": 160,
              "pattern": "^[ -~]+$"
            }
          },
          "required": ["behavior", "name", "visualConcept"],
          "additionalProperties": false
        }
      },
      "required": ["primary", "secondary"],
      "additionalProperties": false
    },
    "vehicleConcept": {
      "description": "Shooter games only. A concrete likeness-independent identity for the player's craft: silhouette, materials, propulsion, canopy, markings, and signature motif. Vertical shooters render it top-down; H-scroll shooters render it from the side. Never describe a human face or body as part of the vehicle.",
      "type": "string",
      "minLength": 12,
      "maxLength": 180,
      "pattern": "^[ -~]+$"
    },
    "fighterArtDirection": {
      "description": "Fighter only. One immutable visual-language contract shared by story art, the complete roster, all combat poses, and generated arenas.",
      "type": "object",
      "properties": {
        "aesthetic": { "enum": ["cartoon", "stylized", "semi-realistic"] },
        "proportions": {
          "type": "string",
          "minLength": 12,
          "maxLength": 140,
          "pattern": "^[ -~]+$"
        },
        "rendering": {
          "type": "string",
          "minLength": 12,
          "maxLength": 160,
          "pattern": "^[ -~]+$"
        }
      },
      "required": ["aesthetic", "proportions", "rendering"],
      "additionalProperties": false
    },
    "story": {
      "type": "object",
      "properties": {
        "intro": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[ -~]+$" }
        },
        "levelIntros": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[ -~]+$" }
        },
        "bossIntro": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[ -~]+$" },
        "victory": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[ -~]+$" }
        },
        "defeat": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[ -~]+$" }
        }
      },
      "required": ["intro", "levelIntros", "bossIntro", "victory", "defeat"],
      "additionalProperties": false
    },
    "levelPlan": {
      "description": "Exactly 4 entries: level 1, level 2, level 3, boss.",
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 24, "pattern": "^[ -~]+$" },
          "summary": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[ -~]+$" }
        },
        "required": ["name", "summary"],
        "additionalProperties": false
      }
    },
    "cast": {
      "description": "Enemy cast mapped onto the archetype's enemy vocabulary.",
      "type": "array",
      "minItems": 4,
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "description": "An enemy type from the chosen archetype's vocabulary.",
            "type": "string",
            "minLength": 1,
            "maxLength": 24,
            "pattern": "^[a-z][a-zA-Z0-9_]{0,23}$"
          },
          "concept": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[ -~]+$" }
        },
        "required": ["role", "concept"],
        "additionalProperties": false
      }
    },
    "musicBrief": {
      "type": "object",
      "properties": {
        "key": { "type": "string", "minLength": 1, "maxLength": 16, "pattern": "^[ -~]+$" },
        "bpm": { "type": "integer", "minimum": 70, "maximum": 200 },
        "themeMood": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[ -~]+$" },
        "bossMood": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[ -~]+$" }
      },
      "required": ["key", "bpm", "themeMood", "bossMood"],
      "additionalProperties": false
    },
    "scoring": {
      "type": "object",
      "properties": {
        "events": {
          "type": "object",
          "properties": {
            "enemyKill": { "type": "integer", "minimum": 0, "maximum": 100000 },
            "pickup": { "type": "integer", "minimum": 0, "maximum": 100000 },
            "bossHit": { "type": "integer", "minimum": 0, "maximum": 100000 },
            "levelClear": { "type": "integer", "minimum": 0, "maximum": 100000 }
          },
          "required": ["enemyKill", "pickup", "bossHit", "levelClear"],
          "additionalProperties": false
        },
        "timeBonusPerSecond": { "type": "integer", "minimum": 0, "maximum": 1000 }
      },
      "required": ["events", "timeBonusPerSecond"],
      "additionalProperties": false
    },
    "difficulty": { "enum": ["chill", "standard", "spicy"] },
    "platformerScale": {
      "description": "Platformer only. 'heroic' is a close, actor-forward 2x view and the default choice; use 'compact' only when a tiny hero, swarms, speed, or broad traversal is central to the premise. Omit for other archetypes.",
      "enum": ["compact", "heroic"]
    },
    "platformerArtDensity": {
      "description": "Platformer only. With a likeness photo, 'detailed' is the default and enables higher-resolution generated player art without changing collision or world size. Use 'chunky' without a photo or for a deliberately coarse, tiny, toy-like, or early-console pixel aesthetic. Omit for other archetypes.",
      "enum": ["chunky", "detailed"]
    },
    "movementProfile": {
      "description": "Platformer only. Choose one bounded engine-owned movement style: balanced for general play, precision for crisp exact control, momentum for speed with retained inertia, floaty for airy/moonlike motion, or heavy for weighty armored/industrial motion. Omit for other archetypes.",
      "enum": ["balanced", "precision", "momentum", "floaty", "heavy"]
    },
    "feel": {
      "description": "Legacy platformer-only numeric movement overlay retained for saved checkpoints. New designs should choose movementProfile and omit feel. Omit entirely for non-platformer games.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gravityScale": {
          "type": "number",
          "minimum": 0.72,
          "maximum": 1,
          "description": "lower = floatier, more airtime"
        },
        "jumpScale": {
          "type": "number",
          "minimum": 1,
          "maximum": 1.25,
          "description": "higher = taller jump"
        },
        "speedScale": {
          "type": "number",
          "minimum": 1,
          "maximum": 1.3,
          "description": "higher = faster run"
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "archetype": { "const": "hshooter" } }, "required": ["archetype"] },
      "then": { "required": ["vehicleConcept"] }
    },
    {
      "if": { "properties": { "archetype": { "const": "shooter" } }, "required": ["archetype"] },
      "then": { "required": ["vehicleConcept"] }
    },
    {
      "if": { "properties": { "archetype": { "const": "fighter" } }, "required": ["archetype"] },
      "then": { "required": ["fighterArtDirection"] }
    },
    {
      "if": { "properties": { "archetype": { "const": "adventure" } }, "required": ["archetype"] },
      "then": { "required": ["combatKit"] }
    }
  ],
  "required": [
    "title",
    "tagline",
    "archetype",
    "palette",
    "heroConcept",
    "story",
    "levelPlan",
    "cast",
    "musicBrief",
    "scoring",
    "difficulty"
  ],
  "additionalProperties": false
}

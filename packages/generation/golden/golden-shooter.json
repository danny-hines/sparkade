 "story": {
  "bossIntro": "The Entropy Engine roars awake: I am the drift you cannot tune. Try to align me, signal.",
  "defeat": [
   "Signal faded but not lost. Reset your course, Alexandr, the craft is waiting."
  ],
  "intro": [
   "You are Alexandr, piloting a bright signal craft upward through an unfinished mind.",
      "An ocean of data below, a frontier of reasoning ahead. Your task: assemble an aligned personal superintelligence and place it in people's hands."
  ],
  "levelIntros": [
   "Data Ocean: You dive into the roaring Data Ocean where noise churns. Gather Context to steady the beam.",
   "Training Orbit: You spiral into Training Orbit where evaluations flicker and break. Collect Multimodality and Tool Use to learn fast.",
   "Reasoning Frontier: You pierce the Reasoning Frontier where logic thins. Hold Alignment tight as entropy presses in."
  ],
  "victory": [
   "The Engine quiets. The signal holds bright, aligned and ready, Alexandr guiding it home.",
      "You place a powerful personal agent into people's hands, open and hopeful. The ascent is complete."
  ]
 },

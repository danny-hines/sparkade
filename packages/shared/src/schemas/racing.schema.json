{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sparkade://schemas/racing",
  "title": "Sparkade hover-cup racing spec (specVersion 1)",
  "type": "object",
  "properties": {
    "specVersion": {
      "const": 1
    },
    "archetype": {
      "const": "racing"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "palette": {
      "$ref": "#/$defs/palette"
    },
    "story": {
      "$ref": "#/$defs/story"
    },
    "sprites": {
      "$ref": "#/$defs/spritesBlock"
    },
    "weather": {
      "description": "Ambient engine weather drawn over the race by the host. Omit or none for clear.",
      "enum": [
        "none",
        "rain",
        "storm",
        "snow",
        "embers",
        "ash",
        "leaves",
        "petals",
        "fog",
        "bubbles",
        "fireflies",
        "dust"
      ]
    },
    "lighting": {
      "description": "Host lighting wash over the scene. Omit or none for untinted.",
      "enum": [
        "none",
        "dawn",
        "dusk",
        "night",
        "gloom"
      ]
    },
    "juice": {
      "description": "Screen-shake intensity multiplier (0-1.5). Omit for 1.",
      "type": "number",
      "minimum": 0,
      "maximum": 1.5
    },
    "difficulty": {
      "description": "Rival-aggression tier; assembled from the design doc, not authored in this stage.",
      "enum": [
        "chill",
        "standard",
        "spicy"
      ]
    },
    "levels": {
      "description": "The cup: exactly the 3 circuits in race order.",
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/circuit"
      }
    },
    "boss": {
      "$ref": "#/$defs/racingBoss"
    },
    "identity": {
      "$ref": "#/$defs/racingIdentity"
    },
    "music": {
      "$ref": "#/$defs/music"
    },
    "sfx": {
      "$ref": "#/$defs/sfx"
    },
    "scoring": {
      "$ref": "#/$defs/scoring"
    }
  },
  "required": [
    "specVersion",
    "archetype",
    "seed",
    "meta",
    "palette",
    "story",
    "sprites",
    "levels",
    "boss",
    "music",
    "scoring"
  ],
  "additionalProperties": false,
  "$defs": {
    "hexColor": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "palette": {
      "description": "Exactly 16 hex colors. Index 0 is always treated as transparent in sprites. Slot conventions: 1 outline/darkest, 2-4 background dark->light, 5-7 hero, 8-a enemies, b hazard, c warm accent, d gold, e light, f near-white.",
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/hexColor"
      }
    },
    "text": {
      "description": "Display text: printable ASCII only (the bitmap font has no other glyphs).",
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[ -~]+$"
    },
    "shortName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 24,
      "pattern": "^[ -~]+$"
    },
    "spriteRef": {
      "description": "Either 'lib:<id>' for a built-in library sprite or 'custom:<id>' for one defined in sprites.custom.",
      "type": "string",
      "pattern": "^(lib|custom):[a-z][a-z0-9_]{0,31}$"
    },
    "sprite": {
      "description": "Palette-indexed pixel art. Characters 0-f index the 16-color palette, '.' is transparent. Every row must be exactly w characters long and rows.length must equal h.",
      "type": "object",
      "properties": {
        "w": {
          "type": "integer",
          "minimum": 4,
          "maximum": 48
        },
        "h": {
          "type": "integer",
          "minimum": 4,
          "maximum": 48
        },
        "rows": {
          "type": "array",
          "minItems": 4,
          "maxItems": 48,
          "items": {
            "type": "string",
            "minLength": 4,
            "maxLength": 48,
            "pattern": "^[0-9a-f.]+$"
          }
        },
        "frames": {
          "description": "Optional extra animation frames, each the same size (w by h) as rows; the engine cycles [rows, ...frames] as an idle/walk loop.",
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "array",
            "minItems": 4,
            "maxItems": 48,
            "items": {
              "type": "string",
              "minLength": 4,
              "maxLength": 48,
              "pattern": "^[0-9a-f.]+$"
            }
          }
        },
        "headSlot": {
          "description": "Optional, heroes only: where the player's photo-likeness head is composited onto this sprite. x/y is the top-left in sprite pixels; size 12 or 16 picks the baked head. Put it on a custom hero body you want to wear the player's face.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": {
              "type": "integer",
              "minimum": 0,
              "maximum": 48
            },
            "y": {
              "type": "integer",
              "minimum": 0,
              "maximum": 48
            },
            "size": {
              "enum": [
                12,
                16
              ]
            }
          },
          "required": [
            "x",
            "y",
            "size"
          ]
        }
      },
      "required": [
        "w",
        "h",
        "rows"
      ],
      "additionalProperties": false
    },
    "meta": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[ -~]+$"
        },
        "tagline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[ -~]+$"
        },
        "heroConcept": {
          "type": "string",
          "minLength": 1,
          "maxLength": 220,
          "pattern": "^[ -~]+$"
        }
      },
      "required": [
        "title",
        "tagline"
      ],
      "additionalProperties": false
    },
    "story": {
      "type": "object",
      "properties": {
        "intro": {
          "description": "1-3 story cards shown before level 1.",
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "levelIntros": {
          "description": "One card per level, exactly 3.",
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "bossIntro": {
          "$ref": "#/$defs/text"
        },
        "victory": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "defeat": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/text"
          }
        }
      },
      "required": [
        "intro",
        "levelIntros",
        "bossIntro",
        "victory",
        "defeat"
      ],
      "additionalProperties": false
    },
    "spritesBlock": {
      "type": "object",
      "properties": {
        "custom": {
          "description": "Custom pixel-art sprites by id. May be empty \u2014 library sprites are always available.",
          "type": "object",
          "maxProperties": 24,
          "patternProperties": {
            "^[a-z][a-z0-9_]{0,31}$": {
              "$ref": "#/$defs/sprite"
            }
          },
          "additionalProperties": false
        },
        "assign": {
          "description": "role -> sprite reference. 'hero' and 'boss' are required; add one entry per enemy/pickup role you use.",
          "type": "object",
          "properties": {
            "hero": {
              "$ref": "#/$defs/spriteRef"
            },
            "boss": {
              "$ref": "#/$defs/spriteRef"
            }
          },
          "required": [
            "hero",
            "boss"
          ],
          "patternProperties": {
            "^[a-z][a-z0-9_]{0,23}$": {
              "$ref": "#/$defs/spriteRef"
            }
          },
          "additionalProperties": false,
          "maxProperties": 24
        }
      },
      "required": [
        "custom",
        "assign"
      ],
      "additionalProperties": false
    },
    "pulseInstrument": {
      "type": "object",
      "properties": {
        "duty": {
          "enum": [
            0.125,
            0.25,
            0.5
          ]
        },
        "vol": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "decay": {
          "type": "number",
          "minimum": 0.02,
          "maximum": 1.5
        }
      },
      "required": [
        "duty",
        "vol",
        "decay"
      ],
      "additionalProperties": false
    },
    "bassInstrument": {
      "type": "object",
      "properties": {
        "vol": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "decay": {
          "type": "number",
          "minimum": 0.02,
          "maximum": 1.5
        }
      },
      "required": [
        "vol",
        "decay"
      ],
      "additionalProperties": false
    },
    "drumInstrument": {
      "type": "object",
      "properties": {
        "vol": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "vol"
      ],
      "additionalProperties": false
    },
    "instruments": {
      "type": "object",
      "properties": {
        "pulse1": {
          "$ref": "#/$defs/pulseInstrument"
        },
        "pulse2": {
          "$ref": "#/$defs/pulseInstrument"
        },
        "bass": {
          "$ref": "#/$defs/bassInstrument"
        },
        "drums": {
          "$ref": "#/$defs/drumInstrument"
        }
      },
      "required": [
        "pulse1",
        "pulse2",
        "bass",
        "drums"
      ],
      "additionalProperties": false
    },
    "noteStep": {
      "description": "'-' = rest, or '<note><octave>:<duration-in-16ths>' e.g. 'C4:2', 'Eb3:4', 'F#5:1'. Octaves 1-7, duration 1-16.",
      "type": "string",
      "pattern": "^(-|[A-G][#b]?[1-7]:(1[0-6]|[1-9]))$"
    },
    "drumStep": {
      "enum": [
        "K",
        "S",
        "H",
        "-"
      ]
    },
    "noteChannel": {
      "description": "Exactly 16 steps (one bar of 16ths).",
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/noteStep"
      }
    },
    "drumChannel": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/drumStep"
      }
    },
    "pattern": {
      "description": "One bar. Channels are optional; include only the ones that play.",
      "type": "object",
      "properties": {
        "pulse1": {
          "$ref": "#/$defs/noteChannel"
        },
        "pulse2": {
          "$ref": "#/$defs/noteChannel"
        },
        "bass": {
          "$ref": "#/$defs/noteChannel"
        },
        "drums": {
          "$ref": "#/$defs/drumChannel"
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "songRefList": {
      "description": "Ordered list of pattern names to play in sequence (looped).",
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,15}$"
      }
    },
    "music": {
      "type": "object",
      "properties": {
        "bpm": {
          "type": "integer",
          "minimum": 70,
          "maximum": 200
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "pattern": "^[ -~]+$"
        },
        "instruments": {
          "$ref": "#/$defs/instruments"
        },
        "patterns": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 24,
          "patternProperties": {
            "^[a-zA-Z][a-zA-Z0-9_]{0,15}$": {
              "$ref": "#/$defs/pattern"
            }
          },
          "additionalProperties": false
        },
        "songs": {
          "type": "object",
          "properties": {
            "theme": {
              "$ref": "#/$defs/songRefList"
            },
            "boss": {
              "$ref": "#/$defs/songRefList"
            }
          },
          "required": [
            "theme",
            "boss"
          ],
          "patternProperties": {
            "^[a-z][a-zA-Z0-9_]{0,15}$": {
              "$ref": "#/$defs/songRefList"
            }
          },
          "additionalProperties": false,
          "maxProperties": 6
        },
        "jingles": {
          "type": "object",
          "properties": {
            "victory": {
              "$ref": "#/$defs/pattern"
            },
            "gameover": {
              "$ref": "#/$defs/pattern"
            },
            "levelIntro": {
              "$ref": "#/$defs/pattern"
            }
          },
          "required": [
            "victory",
            "gameover",
            "levelIntro"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "bpm",
        "key",
        "instruments",
        "patterns",
        "songs",
        "jingles"
      ],
      "additionalProperties": false
    },
    "sfxParams": {
      "type": "object",
      "properties": {
        "wave": {
          "enum": [
            "square",
            "saw",
            "sine",
            "noise",
            "triangle"
          ]
        },
        "freq": {
          "type": "number",
          "minimum": 40,
          "maximum": 4000
        },
        "freqSlide": {
          "description": "Semitones per second of pitch slide (negative = down).",
          "type": "number",
          "minimum": -48,
          "maximum": 48
        },
        "attack": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5
        },
        "sustain": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5
        },
        "decay": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 1
        },
        "duty": {
          "enum": [
            0.125,
            0.25,
            0.5
          ]
        },
        "vol": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "vibratoDepth": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "vibratoSpeed": {
          "type": "number",
          "minimum": 0,
          "maximum": 40
        },
        "arpSemitones": {
          "type": "number",
          "minimum": -24,
          "maximum": 24
        },
        "arpTime": {
          "type": "number",
          "minimum": 0.02,
          "maximum": 0.5
        },
        "lowpass": {
          "type": "number",
          "minimum": 100,
          "maximum": 8000
        }
      },
      "required": [
        "wave",
        "freq",
        "decay"
      ],
      "additionalProperties": false
    },
    "sfx": {
      "description": "Optional overrides only \u2014 omit an event to keep the engine default.",
      "type": "object",
      "properties": {
        "jump": {
          "$ref": "#/$defs/sfxParams"
        },
        "shoot": {
          "$ref": "#/$defs/sfxParams"
        },
        "hit": {
          "$ref": "#/$defs/sfxParams"
        },
        "hurt": {
          "$ref": "#/$defs/sfxParams"
        },
        "die": {
          "$ref": "#/$defs/sfxParams"
        },
        "pickup": {
          "$ref": "#/$defs/sfxParams"
        },
        "powerup": {
          "$ref": "#/$defs/sfxParams"
        },
        "uiMove": {
          "$ref": "#/$defs/sfxParams"
        },
        "uiSelect": {
          "$ref": "#/$defs/sfxParams"
        },
        "uiBack": {
          "$ref": "#/$defs/sfxParams"
        },
        "win": {
          "$ref": "#/$defs/sfxParams"
        },
        "lose": {
          "$ref": "#/$defs/sfxParams"
        }
      },
      "additionalProperties": false
    },
    "scoring": {
      "type": "object",
      "properties": {
        "events": {
          "type": "object",
          "properties": {
            "enemyKill": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            "pickup": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            "bossHit": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            "levelClear": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            }
          },
          "required": [
            "enemyKill",
            "pickup",
            "bossHit",
            "levelClear"
          ],
          "additionalProperties": false
        },
        "timeBonusPerSecond": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      },
      "required": [
        "events",
        "timeBonusPerSecond"
      ],
      "additionalProperties": false
    },
    "wave": {
      "type": "object",
      "properties": {
        "t": {
          "description": "Seconds from level start when the wave spawns (enemies enter from the right). Must be sorted ascending and within durationS.",
          "type": "number",
          "minimum": 0,
          "maximum": 300
        },
        "enemyType": {
          "enum": [
            "popcorn",
            "weaver",
            "tank",
            "turret",
            "kamikaze"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "formation": {
          "enum": [
            "line",
            "vee",
            "column",
            "arc"
          ]
        },
        "path": {
          "enum": [
            "dive",
            "sweep",
            "sine",
            "hold"
          ]
        },
        "hp": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "fireRate": {
          "description": "Shots per second per enemy (0 = never fires).",
          "type": "number",
          "minimum": 0,
          "maximum": 2
        }
      },
      "required": [
        "t",
        "enemyType",
        "count",
        "formation",
        "path",
        "hp",
        "fireRate"
      ],
      "additionalProperties": false
    },
    "levelPickup": {
      "type": "object",
      "properties": {
        "t": {
          "type": "number",
          "minimum": 0,
          "maximum": 300
        },
        "type": {
          "enum": [
            "spread",
            "rapid",
            "shield",
            "bomb"
          ]
        }
      },
      "required": [
        "t",
        "type"
      ],
      "additionalProperties": false
    },
    "legendTile": {
      "description": "A tile kind. 'solid' = ceiling/floor/obstacle the ship AND enemies collide with; 'hazard' = damages on contact (fly-through); 'decoration' = cosmetic (no collision). '.' is always empty.",
      "enum": [
        "solid",
        "hazard",
        "decoration"
      ]
    },
    "level": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/shortName"
        },
        "musicSong": {
          "description": "Must be a key of music.songs.",
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9_]{0,15}$"
        },
        "scroll": {
          "description": "Stage + backdrop scroll speed in px/s.",
          "type": "number",
          "minimum": 20,
          "maximum": 120
        },
        "durationS": {
          "description": "Level length in seconds; the level ends when the clock runs out and all enemies are cleared.",
          "type": "integer",
          "minimum": 45,
          "maximum": 150
        },
        "tiles": {
          "description": "The stage as row strings, top to bottom (like a platformer level, but it auto-scrolls). Every row must be the SAME length. Make it ~19 rows tall to fill the screen; a solid ceiling band up top and floor band along the bottom, plus mid-field obstacle blocks to weave around. The complete autoscroll must retain a ship-sized, speed-reachable corridor with gradual readable lane changes; cell connectivity alone is insufficient. Width must cover the whole scroll: cols*16 >= scroll*durationS + a screen. 1 tile = 16px. '.' = empty.",
          "type": "array",
          "minItems": 12,
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 40,
            "maxLength": 340,
            "pattern": "^[ -~]+$"
          }
        },
        "legend": {
          "description": "Single character -> tile kind. '.' is always empty and may be omitted.",
          "type": "object",
          "minProperties": 1,
          "maxProperties": 12,
          "patternProperties": {
            "^[ -~]$": {
              "$ref": "#/$defs/legendTile"
            }
          },
          "additionalProperties": false
        },
        "waves": {
          "type": "array",
          "minItems": 3,
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/wave"
          }
        },
        "pickups": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/levelPickup"
          }
        }
      },
      "required": [
        "name",
        "musicSong",
        "scroll",
        "durationS",
        "tiles",
        "legend",
        "waves",
        "pickups"
      ],
      "additionalProperties": false
    },
    "boss": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/shortName"
        },
        "hp": {
          "type": "integer",
          "minimum": 40,
          "maximum": 200
        },
        "pods": {
          "description": "Number of destructible weapon pods (0-4).",
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "podHp": {
          "type": "integer",
          "minimum": 4,
          "maximum": 40
        },
        "phases": {
          "description": "2-3 bullet-pattern phases, entered at equal HP fractions.",
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "type": "object",
            "properties": {
              "pattern": {
                "enum": [
                  "fan",
                  "spiral",
                  "walls",
                  "aimed"
                ]
              },
              "bulletSpeed": {
                "type": "number",
                "minimum": 0.5,
                "maximum": 2
              },
              "fireIntervalMs": {
                "type": "integer",
                "minimum": 300,
                "maximum": 2500
              }
            },
            "required": [
              "pattern",
              "bulletSpeed",
              "fireIntervalMs"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "name",
        "hp",
        "pods",
        "podHp",
        "phases"
      ],
      "additionalProperties": false
    },
    "circuitTheme": {
      "description": "Optional per-circuit presentation override. Omitted fields keep the template-authored theme; every applied field actually re-skins the race.",
      "type": "object",
      "properties": {
        "scenery": {
          "enum": [
            "posts",
            "pines",
            "crystals"
          ]
        },
        "skyTop": {
          "$ref": "#/$defs/hexColor"
        },
        "skyBottom": {
          "$ref": "#/$defs/hexColor"
        },
        "sun": {
          "$ref": "#/$defs/hexColor"
        },
        "ridgeFar": {
          "$ref": "#/$defs/hexColor"
        },
        "ridgeNear": {
          "$ref": "#/$defs/hexColor"
        },
        "ground": {
          "$ref": "#/$defs/hexColor"
        },
        "accent": {
          "$ref": "#/$defs/hexColor"
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "rival": {
      "description": "One AI rival: display name plus top-speed scale. Bounded fair physics \u2014 never above the player top speed (1.0), never below 0.7.",
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/shortName"
        },
        "topScale": {
          "type": "number",
          "minimum": 0.7,
          "maximum": 1.0
        }
      },
      "required": [
        "name",
        "topScale"
      ],
      "additionalProperties": false
    },
    "circuit": {
      "description": "One cup circuit: a proven template plus bounded authored identity. Geometry always comes from the template \u2014 the model may never invent control points.",
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/shortName"
        },
        "template": {
          "description": "Proven closed-circuit template: ember (hairpin + S-curves), coral (fast sweepers), ratchet (tight chicanes). Any template may open the cup or host the finale.",
          "enum": [
            "ember",
            "coral",
            "ratchet"
          ]
        },
        "laps": {
          "description": "Cup races are always 3 laps.",
          "const": 3
        },
        "musicSong": {
          "description": "Must be a key of music.songs.",
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9_]{0,15}$"
        },
        "rivals": {
          "description": "Exactly the 4 AI rivals for this race, in grid order.",
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/rival"
          }
        },
        "theme": {
          "$ref": "#/$defs/circuitTheme"
        },
        "timeoutS": {
          "description": "Race clock limit in seconds; unfinished racers score DNF past it. Floor 220s keeps a 3-lap race winnable with margin. Omit for the template default.",
          "type": "integer",
          "minimum": 220,
          "maximum": 400
        },
        "length": {
          "description": "Lap length in track units (2800-3600). Rescales the proven template; curvature shifts inversely. Omit for the template length.",
          "type": "integer",
          "minimum": 2800,
          "maximum": 3600
        },
        "mirror": {
          "description": "Mirror the template across the racing line (reverses turn direction). Omit or false for the authored direction.",
          "type": "boolean"
        },
        "elevation": {
          "description": "Optional bounded elevation profile (periodic analytic height over the lap: rolling rises or a ridge climb). Omit or flat for legacy flat geometry exactly.",
          "enum": [
            "flat",
            "rolling",
            "ridge"
          ]
        },
        "jumps": {
          "description": "Optional bounded jump ramps: 1-2 deterministic centered ramp zones with an avoidance line each side. Omit or none for legacy flat racing exactly.",
          "enum": [
            "none",
            "ramps"
          ]
        },
        "forks": {
          "description": "Optional bounded fork split: at most one deterministic two-corridor zone (broad safe left, narrow rewarded right) on a safe quiet interval. Omit or none for the legacy single road exactly.",
          "enum": [
            "none",
            "split"
          ]
        },
        "craftShape": {
          "description": "Player-craft silhouette for this race (procedural originals: dart, twinpod, wedge). Omit for twinpod.",
          "enum": [
            "dart",
            "twinpod",
            "wedge"
          ]
        },
        "envConcept": {
          "description": "Free-text environment visual concept for this circuit (world dressing; panorama/scenery input for a later milestone). Omit for template dressing. Never geometry.",
          "type": "string",
          "minLength": 8,
          "maxLength": 280,
          "pattern": "^[ -~]+$"
        },
        "materials": {
          "$ref": "#/$defs/racingTrackMaterials"
        }
      },
      "required": [
        "name",
        "template",
        "laps",
        "musicSong",
        "rivals"
      ],
      "additionalProperties": false
    },
    "racingBoss": {
      "description": "Final-rival metadata only: a named, slightly faster driver on the finale circuit. No HP, no combat phases, no attacks \u2014 the finale is an honest race.",
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/shortName"
        },
        "rivalIndex": {
          "description": "Which finale-circuit rival (1-4, never the player at 0) carries this name and pace.",
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "topScale": {
          "description": "Finale pace. Bounded like every rival scale: at or below player pace.",
          "type": "number",
          "minimum": 0.9,
          "maximum": 1.0
        },
        "titleQuote": {
          "$ref": "#/$defs/text"
        },
        "title": {
          "$ref": "#/$defs/shortName"
        }
      },
      "required": [
        "name",
        "title",
        "rivalIndex",
        "topScale"
      ],
      "additionalProperties": false
    },
    "conceptText": {
      "description": "Free-text authored concept: printable ASCII, concrete and visual.",
      "type": "string",
      "minLength": 8,
      "maxLength": 280,
      "pattern": "^[ -~]+$"
    },
    "racingEngineProfile": {
      "description": "Stored engine-voice profile for the later audio milestone. Not consumed by the runtime yet.",
      "type": "object",
      "properties": {
        "family": {
          "description": "Bounded engine-voice family.",
          "enum": [
            "electric",
            "combustion",
            "arcane"
          ]
        },
        "tone": {
          "description": "Timbre brightness 0-1. Omit for 0.5.",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "pitch": {
          "description": "Pitch offset in semitones. Omit for 0.",
          "type": "number",
          "minimum": -12,
          "maximum": 12
        }
      },
      "required": [
        "family"
      ],
      "additionalProperties": false
    },
    "racingBoostSupply": {
      "description": "The cup's one primary boost supply, with its in-world display name and concrete appearance concept.",
      "type": "object",
      "properties": {
        "mode": {
          "description": "pads = legacy boost pads; pickups = banked energy cells for manual boost; none = no on-track sources.",
          "enum": [
            "pads",
            "pickups",
            "none"
          ]
        },
        "displayName": {
          "$ref": "#/$defs/shortName"
        },
        "appearanceConcept": {
          "$ref": "#/$defs/conceptText"
        }
      },
      "required": [
        "mode",
        "displayName",
        "appearanceConcept"
      ],
      "additionalProperties": false
    },
    "racingRivalCraft": {
      "description": "One rival's vehicle concept, in stable cast order. The name must match the cup cast slot.",
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/shortName"
        },
        "vehicleConcept": {
          "$ref": "#/$defs/conceptText"
        }
      },
      "required": [
        "name",
        "vehicleConcept"
      ],
      "additionalProperties": false
    },
    "racingTrackMaterials": {
      "description": "Authored track-material styling. Stored now; the renderer consumes it in a later milestone.",
      "type": "object",
      "properties": {
        "road": {
          "$ref": "#/$defs/hexColor"
        },
        "ground": {
          "$ref": "#/$defs/hexColor"
        },
        "curb": {
          "$ref": "#/$defs/hexColor"
        },
        "edge": {
          "$ref": "#/$defs/hexColor"
        },
        "pad": {
          "$ref": "#/$defs/hexColor"
        }
      },
      "required": [
        "road",
        "ground",
        "curb",
        "edge",
        "pad"
      ],
      "additionalProperties": false
    },
    "racingIdentity": {
      "description": "Authored identity contract for a generated racing game. Optional and backwards-compatible: omit on legacy specs. Only racing outputs carry it.",
      "type": "object",
      "properties": {
        "pilotName": {
          "$ref": "#/$defs/shortName",
          "maxLength": 48
        },
        "artDirection": {
          "$ref": "#/$defs/conceptText"
        },
        "worldConcept": {
          "$ref": "#/$defs/conceptText"
        },
        "playerCraftConcept": {
          "$ref": "#/$defs/conceptText"
        },
        "rivalCrafts": {
          "description": "Exactly the 4 rival vehicle concepts, in stable cast order.",
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/racingRivalCraft"
          }
        },
        "sound": {
          "type": "object",
          "properties": {
            "engine": {
              "$ref": "#/$defs/racingEngineProfile"
            }
          },
          "required": [
            "engine"
          ],
          "additionalProperties": false
        },
        "boost": {
          "$ref": "#/$defs/racingBoostSupply"
        },
        "discipline": {
          "description": "Runtime movement discipline for the cup: hover craft or jet-ski. Omit for hover (legacy behavior preserved exactly).",
          "enum": [
            "hover",
            "jetski"
          ]
        },
        "traversal": {
          "description": "Composable traversal contract: a short freeform activity label plus bounded handling/surface (physics) and rider/propulsion (presentation only). Omit to preserve legacy hover/jetski behavior exactly.",
          "type": "object",
          "properties": {
            "motion": {
              "enum": ["static", "pedal", "stride", "push", "pulse"]
            },
            "label": {
              "description": "Short freeform user-facing activity name. Never drives code.",
              "type": "string",
              "minLength": 1,
              "maxLength": 48,
              "pattern": "^[ -~]+$"
            },
            "handling": {
              "enum": ["direct", "grip", "carve", "flow"]
            },
            "surface": {
              "enum": ["ground", "water"]
            },
            "rider": {
              "enum": ["none", "seated", "standing", "onFoot"]
            },
            "propulsion": {
              "enum": ["motor", "human", "magic"]
            }
          },
          "required": ["label", "handling", "surface", "rider", "propulsion"],
          "additionalProperties": false
        }
      },
      "required": [
        "pilotName",
        "artDirection",
        "worldConcept",
        "playerCraftConcept",
        "rivalCrafts",
        "sound",
        "boost"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "identity"
        ]
      },
      "then": {
        "properties": {
          "levels": {
            "items": {
              "required": [
                "envConcept",
                "materials"
              ]
            }
          }
        }
      }
    }
  ]
}
